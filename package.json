{
  "name": "aegis-ai-guard",
  "private": true,
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "node scripts/run-expo.js start --clear",
    "start:dev-client": "node scripts/run-expo.js start --dev-client --clear",
    "android": "node scripts/run-expo.js start --android --clear",
    "ios": "node scripts/run-expo.js start --ios --clear",
    "web": "node scripts/run-expo.js start --web --clear",
    "prebuild:native": "npx expo prebuild --clean",
    "run:native:android": "npx expo run:android",
    "run:native:ios": "npx expo run:ios",
    "build:web": "npx expo export --platform web",
    "deploy:web": "npm run build:web && firebase deploy --only hosting",
    "typecheck": "tsc --noEmit",
    "test:backend": "python -m pytest -q backend/tests",
    "verify": "npm run typecheck && npm run test:backend"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.1",
    "@google/genai": "^1.29.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/auth": "^24.0.0",
    "expo": "~54.0.33",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.10",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "firebase": "^12.11.0",
    "lucide-react-native": "^0.511.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-get-random-values": "^1.11.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "~19.1.10",
    "@types/react-native": "^0.72.8",
    "typescript": "~5.9.2"
  }
}
