# Optional: full backend base URL.
# If set, this takes precedence over the host/port values below.
# The Settings screen can override this value at runtime for testing.
# For production, prefer your Firebase Hosting domain, for example:
# EXPO_PUBLIC_PHISHING_API_URL="https://YOUR_PROJECT.web.app"
EXPO_PUBLIC_PHISHING_API_URL=""

# Optional: Expo dev fallback host/port for local devices and simulators.
# Useful when your backend is reachable on LAN but not via localhost from the client.
EXPO_PUBLIC_PHISHING_API_HOST=""
EXPO_PUBLIC_PHISHING_API_PORT="8000"

# The app also lets you save the Gemini key locally from Settings.
EXPO_PUBLIC_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional overrides for Firebase Google sign-in client IDs.
# The repo already ships with defaults for the Aegis AI Guard Firebase project.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID="662641033139-5vs6pp0gcal7bnbqlfo82u56r20h26oq.apps.googleusercontent.com"
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID="662641033139-ho508okt1iah75gshbt1jr332fnkjmu7.apps.googleusercontent.com"
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID="662641033139-5vs6pp0gcal7bnbqlfo82u56r20h26oq.apps.googleusercontent.com"

# Optional legacy backend Gmail connector start URL.
# Leave blank to derive it from the phishing backend base URL automatically.
EXPO_PUBLIC_GMAIL_OAUTH_URL="https://YOUR_PROJECT.web.app/oauth/gmail/start"
