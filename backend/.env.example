HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LINK_SANDBOX_ENABLED=true
LINK_SANDBOX_TIMEOUT_SECONDS=20
LINK_SANDBOX_CONCURRENCY=2
LINK_SANDBOX_JOB_TTL_SECONDS=900
# Optional: protect /sandbox/inspect-link with a shared secret header X-Sandbox-Key.
LINK_SANDBOX_API_KEY=
SAFE_BROWSING_API_KEY=
SAFE_BROWSING_TIMEOUT_SECONDS=6

# Optional malware detonation service (CAPE or generic REST provider).
DETONATION_ENABLED=false
DETONATION_PROVIDER=generic
DETONATION_SERVICE_BASE_URL=
DETONATION_SERVICE_API_KEY=
DETONATION_TIMEOUT_SECONDS=20
DETONATION_JOB_TTL_SECONDS=86400

# Path to a joblib or pickle model trained on the feature vector:
# [num_links, has_ip_url, num_suspicious_words, num_exclamations, email_length, num_digits, has_html]
PHISHING_MODEL_PATH=backend/models/phishing_model_hybrid.pkl
# Decision threshold for classifying an email as phishing based on model probability.
# Lower values increase phishing recall and higher values increase precision.
PHISHING_DECISION_THRESHOLD=0.60

# Gmail OAuth connector settings
GOOGLE_OAUTH_CLIENT_ID=your-google-web-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-web-oauth-client-secret
# Use a LAN IP or public HTTPS URL when testing on a physical device.
# localhost only works when the browser and backend run on the same machine.
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:8000/oauth/gmail/callback
OAUTH_STATE_SECRET=replace-with-a-long-random-secret

# Comma-separated list of allowed final redirect prefixes from the client app.
# Keep your Expo/native scheme first and add your web origins for browser-based linking.
ALLOWED_CLIENT_REDIRECT_PREFIXES=aegisguard://oauth/gmail,https://aegis-ai-guard.web.app,http://localhost,http://127.0.0.1
ALLOWED_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,https://aegis-ai-guard.web.app

# Optional: persist OAuth-linked mailbox records directly from the backend.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_STORAGE_DATABASE_URL=
